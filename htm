<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Mortgage Calculator (2025 Edition)</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #eef5fc;
      margin: 0;
      padding: 0;
    }
    .navbar {
      background: #fff;
      padding: 10px 20px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.1);
      position: sticky;
      top: 0;
    }
    .navbar a {
      margin-left: 20px;
      color: #4a90e2;
      text-decoration: none;
      font-weight: bold;
    }
    .container {
      max-width: 500px;
      margin: 40px auto;
      background: #fff;
      padding: 30px;
      border-radius: 12px;
      box-shadow: 0 0 15px rgba(0,0,0,0.05);
    }
    input, select, button {
      width: 100%;
      padding: 10px;
      margin-top: 10px;
      border-radius: 6px;
      border: 1px solid #ccc;
      font-size: 16px;
    }
    button {
      background: #4a90e2;
      color: white;
      border: none;
      cursor: pointer;
    }
    h2, .result {
      text-align: center;
    }
    .result {
      margin-top: 20px;
      font-weight: bold;
      font-size: 18px;
    }
    .email-popup {
      margin-top: 30px;
      padding: 15px;
      background: #e7f2ff;
      border-radius: 8px;
      text-align: center;
    }
  </style>
</head>
<body>
  <div class="navbar">
    <div><strong>Mortgage Tools</strong></div>
    <div>
      <a href="index.html">Home</a>
      <a href="article2.html">Fixed vs Variable</a>
      <a href="article3.html">First-Time Buyer</a>
      <a href="article4.html">Credit Score</a>
      <a href="article5.html">Pre-Approval</a>
    </div>
  </div>

  <div class="container">
    <h2>Mortgage Calculator (2025 Edition)</h2>
    <label>Loan Amount (AUD):</label>
    <input type="number" id="loanAmount" placeholder="e.g. 500000" />

    <label>Interest Rate (% Annual):</label>
    <input type="number" id="interestRate" step="0.01" placeholder="e.g. 5.25" />

    <label>Loan Term:</label>
    <select id="loanTerm">
      <option value="15">15 Years</option>
      <option value="20">20 Years</option>
      <option value="25">25 Years</option>
      <option value="30">30 Years</option>
    </select>

    <button onclick="calculateMortgage()">Calculate Monthly Payment</button>
    <div class="result" id="monthlyPayment"></div>

    <div class="email-popup">
      📬 Want more financial tools?<br/>
      Enter your email to receive a free mortgage guide!
      <input type="email" placeholder="Enter your email" />
      <button>Subscribe Now</button>
    </div>
  </div>

  <script>
    function calculateMortgage() {
      const loanAmount = parseFloat(document.getElementById('loanAmount').value);
      const annualInterest = parseFloat(document.getElementById('interestRate').value);
      const years = parseInt(document.getElementById('loanTerm').value);

      if (isNaN(loanAmount) || isNaN(annualInterest)) {
        alert('Please enter valid numbers');
        return;
      }

      const monthlyRate = annualInterest / 100 / 12;
      const numberOfPayments = years * 12;
      const monthlyPayment = loanAmount * monthlyRate / (1 - Math.pow(1 + monthlyRate, -numberOfPayments));

      document.getElementById('monthlyPayment').innerText = `Estimated Monthly Payment: AUD $${monthlyPayment.toFixed(2)}`;
    }
  </script>
</body>
</html>
